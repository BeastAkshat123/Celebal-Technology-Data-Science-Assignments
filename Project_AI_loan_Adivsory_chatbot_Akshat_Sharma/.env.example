# LOCAL USE ONLY. Copy this file to ".env" (remove the ".example") and put
# your real key in. This file is git-ignored so your key never gets committed.
#
# Set ANY ONE of these (priority if multiple: Anthropic > Groq > OpenRouter).
# Without any of them, the agent runs in TEMPLATE MODE.

# Free, no credit card -- https://console.groq.com/keys  (recommended)
GROQ_API_KEY=

# Free, no credit card -- https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Paid -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
